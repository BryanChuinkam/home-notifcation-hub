{
  "name": "home-notification-hub",
  "version": "0.1.0",
  "description": "Self-hosted household notification hub \u2014 development foundation",
  "scripts": {
    "dev": "node scripts/run-app.mjs dev",
    "build": "next build",
    "start": "node scripts/run-app.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:quiet": "bash scripts/quiet.sh npm run check",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup:secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "start:all": "tsx scripts/stack.ts start",
    "stop:all": "tsx scripts/stack.ts stop"
  },
  "type": "module",
  "dependencies": {
    "@next/env": "16.4.3",
    "@node-rs/argon2": "2.2.2",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.8"
  },
  "packageManager": "npm@10.9.8"
}
