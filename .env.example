# Canonical browser origin. HTTP is allowed only for loopback development.
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/development/hub.sqlite
# Generate with npm run setup:secret; put the value only in ignored .env.local.
# Required only until the single administrator has been created.
HUB_SETUP_SECRET=
# Optional Home Assistant integration. Leave blank to use mock devices only.
# Examples: http://192.168.1.50:8123 or https://ha.home (no /api path).
HOME_ASSISTANT_URL=
# Required for hostnames; literal URL IPs may omit it. Pin a private/loopback IP.
HOME_ASSISTANT_ADDRESS=
# Create on your Home Assistant profile under Security. Never use NEXT_PUBLIC_.
HOME_ASSISTANT_TOKEN=
# For a trusted private HA certificate authority, configure NODE_EXTRA_CA_CERTS
# before starting Node. Never disable certificate verification.

# Optional JSON array of explicit Google Broadcast / Android TV profiles.
# See docs/ops/real-devices.md. Leave blank until the HA receiver is configured.
HOME_ASSISTANT_DEVICE_PROFILES=

# Optional replacement UTM VM UUID for start:all (defaults to the installed HA VM).
HUB_UTM_VM_ID=
